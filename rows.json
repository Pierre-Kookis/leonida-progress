{
 "github": "https://github.com/ItsNotRexed/Leonida",
 "raw": "https://raw.githubusercontent.com/ItsNotRexed/Leonida",
 "api_commit": "https://api.github.com/repos/ItsNotRexed/Leonida/commits?sha=main&per_page=1",
 "milestones": {"area": "D3D12 → Vulkan boot milestones", "path": "docs/d3d12_vulkan.md"},
 "isa_doc": {
  "path": "docs/isa_coverage.md",
  "regex": "([\\d,]+) RDNA2 instructions: (\\d+) handled-exact, (\\d+) handled-family, (\\d+) refused.*?(\\d+)\\s+unknown"
 },
 "rows": [
  {"area": "Shader translator (RDNA2 → SPIR-V)", "label": "Corpus shaders translate + pass spirv-val",
   "path": "docs/design.md", "regex": "All (?P<n>[\\d,]+) shaders translate and pass `spirv-val`"},
  {"area": "Shader translator (RDNA2 → SPIR-V)", "label": "FSPX FidelityFX programs translate",
   "path": "docs/README.md", "regex": "fspx\\.md.*?(?P<n>\\d+) of (?P<d>\\d+) translate"},
  {"area": "Shader translator (RDNA2 → SPIR-V)", "label": "BVH builder FSSM programs pass spirv-val",
   "path": "docs/d3d12_vulkan.md", "regex": "builder's (?P<d>\\d+) console `FSSM` programs \\((?P<n>\\d+) pass `spirv-val`"},
  {"area": "Runtime loader", "label": "Package DLLs map and bind every import",
   "path": "docs/runtime_imports.md", "table": "| Image | Size of image", "match": "0"},
  {"area": "Runtime loader", "label": "Xbox-only import uses served by shims",
   "path": "docs/runtime_imports.md", "table": "| Consumer | Import | Binding", "match": "shim"},
  {"area": "Runtime loader", "label": "Game executable present",
   "path": "docs/runtime_imports.md", "absent": "executable is still missing"},
  {"area": "Assets (decoded without the executable)", "label": "Models decoded",
   "path": "docs/design.md", "regex": "(?P<f>[\\d,]+) decode failures across all (?P<d>[\\d,]+) models"},
  {"area": "Assets (decoded without the executable)", "label": "TTPF textures, rpf9dump strict decode",
   "path": "docs/README.md", "regex": "(?P<d>[\\d,]+) TTPF descriptors.*?decodes (?P<n>[\\d,]+) strict-clean"},
  {"area": "Assets (decoded without the executable)", "label": "Multi-slice textures resolved",
   "path": "docs/textures_arrays.md", "regex": "layout-validated \\(byte-exact span\\)\\*\\* \\| \\*\\*(?P<n>\\d+) / (?P<d>\\d+)"},
  {"area": "Assets (decoded without the executable)", "label": "Character textures matched",
   "path": "docs/character_models.md", "regex": "requested (?P<d>\\d+) texture keys and matched \\*\\*(?P<n>\\d+)\\*\\*"},
  {"area": "Assets (decoded without the executable)", "label": "PSIN block bytes reached",
   "path": "docs/psin.md", "regex": "\\| \\*\\*all\\*\\* \\|[^\\n]*?\\*\\*(?P<d>[\\d,]+)\\*\\* \\| \\*\\*(?P<n>[\\d,]+)\\*\\* \\("},
  {"area": "Assets (decoded without the executable)", "label": "World entity names resolved",
   "path": "docs/README.md", "regex": "(?P<p>[\\d.]+)% of the [\\d,]+ entities"},
  {"area": "Assets (decoded without the executable)", "label": "levels.rpf bytes in accepted streams",
   "path": "docs/world_census.md", "regex": "Accepted stream payload \\| [\\d,]+ \\| (?P<p>[\\d.]+)%"},
  {"area": "Assets (decoded without the executable)", "label": "navmeshes.rpf bytes in streams",
   "path": "docs/navmesh.md", "regex": "Stored \\(compressed\\) bytes \\| [\\d,]+ \\((?P<p>[\\d.]+)% of span\\)"},
  {"area": "Assets (decoded without the executable)", "label": "anim.rpf bytes readable",
   "path": "docs/animation.md", "regex": "\\| readable \\| (?P<p>[\\d.]+)% of span"},
  {"area": "Assets (decoded without the executable)", "label": "common.rpf streams readable",
   "path": "docs/design.md", "regex": "`common\\.rpf`: [^|]*?(?P<p>[\\d.]+)% readable"},
  {"area": "Assets (decoded without the executable)", "label": "Radio titles resolved exactly",
   "path": "docs/radio_stations.md", "regex": "(?P<n>\\d+)/(?P<d>\\d+) exact `joaat"},
  {"area": "Assets (decoded without the executable)", "label": "Mission states named",
   "path": "docs/mission_logic.md", "regex": "\\((?P<n>[\\d,]+) of (?P<d>[\\d,]+)\\)"}
 ]
}
